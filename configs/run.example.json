{
  "run_id": "example-billing",
  "mode": "checkpoint",
  "goal": "Implement billing module with tests and docs",
  "spec": "# SPEC — billing module\n- Types: Invoice, LineItem\n- Logic: total with tax, discount\n- Tests: unit + integration\n- Docs: README snippet",
  "budget": {
    "max_wall_clock": "30m",
    "max_tokens": 50000,
    "max_iterations": 30,
    "max_retries_per_task": 3
